#!/bin/sh
#
# css/・js/・data/ を直したら demo/*.html も作り直す、を機械的に守らせる。
# README「css/・js/・data/ を直したら4枚とも作り直すこと」の取りこぼし対策。
#
# 有効にするには（最初に一度だけ）:
#   git config core.hooksPath .githooks

changed=$(git diff --cached --name-only --diff-filter=ACMR)

# data/source/ は中間生成物で demo/*.html には入らないので対象外
relevant=$(printf '%s\n' "$changed" | grep -E '^(css/|js/|tools/build-demo\.js|data/)' | grep -v '^data/source/')

if [ -z "$relevant" ]; then
  exit 0
fi

echo "css・js・data に手が入っているので、demo/ が最新か確かめる..."
node tools/check-demo-fresh.js
status=$?

if [ "$status" -ne 0 ]; then
  echo ""
  echo "commit を中止した。demo/ を作り直してから git add し直すこと。"
  echo "急ぎで確認だけ先に commit したいときは git commit --no-verify。"
  exit 1
fi

exit 0
